class Solution(object):
    def trap(self, h):

        n = len(h)

        # Arrays to store left and right maximum heights
        left = [0] * n
        right = [0] * n

        # Water trapped
        trapped_water = 0

        # Left maximum
        left[0] = h[0]

        # Right maximum
        right[n - 1] = h[n - 1]

        # Fill left max array
        for i in range(1, n):
            left[i] = max(left[i - 1], h[i])

        # Fill right max array
        for i in range(n - 2, -1, -1):
            right[i] = max(right[i + 1], h[i])

        # Calculate trapped water
        for i in range(n):
            trapped_water += min(left[i], right[i]) - h[i]

        return trapped_water
