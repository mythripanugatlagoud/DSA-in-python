class Solution(object):
    def twoSum(self, nums, target):
        hashMap = {}

        for i in range(0,len(nums)):
            search = target - nums[i]
            if search in hashMap:
                return [i,hashMap[search]]
            hashMap[nums[i]] = i
            
        
